# Open1602's own texts in English: menus, questions and messages the original game does not have.
# The original's texts come from its data files. Every key needs a line here; other languages fall
# back to this file for keys they lack. Format: docs/modding/languages.md.

language.name = English
# A line of [PLAYCOL] in Text.cod that only an installation in this language has (several: a|b).
language.detect = Red Player|Red player

